{
  "name": "module-debugger-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Mocha tests for ReplayRuntime / module-debugger recording track",
  "type": "module",
  "scripts": {
    "test": "tsx node_modules/.bin/mocha --timeout 300000 --ignore 'src/fixtures.generate.test.ts' --ignore 'src/replay.e2e.test.ts' 'src/**/*.test.ts'",
    "test:stack": "tsx node_modules/.bin/mocha --timeout 300000 src/fixtures.generate.test.ts src/replay.e2e.test.ts",
    "test:watch": "tsx node_modules/.bin/mocha --watch --timeout 300000 --ignore 'src/fixtures.generate.test.ts' --ignore 'src/replay.e2e.test.ts' 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@daemonarium/fs": "0.1.0",
    "@daemonarium/kernel": "0.1.0",
    "@daemonarium/replay": "0.1.0",
    "@daemonarium/rpc": "0.1.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.18.11",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "tsx": "^4.7.0",
    "typescript": "~5.9.0"
  }
}
